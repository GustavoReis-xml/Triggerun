<Window x:Class="TriggerunLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trigger Run - Launcher" 
        Height="550" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilos e Cores Principais -->
        <SolidColorBrush x:Key="BgDark" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBg" Color="#161B22" />
        <SolidColorBrush x:Key="CardBorder" Color="#30363D" />
        <SolidColorBrush x:Key="CyanNeon" Color="#00F0FF" />
        <SolidColorBrush x:Key="CyanGlow" Color="#1F6FEB" />
        <SolidColorBrush x:Key="OrangeAccent" Color="#FF7A00" />
        <SolidColorBrush x:Key="TextWhite" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E" />
        <SolidColorBrush x:Key="OnlineGreen" Color="#3FB950" />
        <SolidColorBrush x:Key="OfflineRed" Color="#F85149" />

        <!-- Estilo de Botão de Fechar/Minimizar -->
        <Style x:Key="WindowCtrlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowCtrlBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DA3633"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo TextBox Moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="#00F0FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Borda Principal Arredondada com Sombra -->
    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource CyanGlow}" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="25" Opacity="0.25" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/> <!-- Barra de Título -->
                <RowDefinition Height="*"/>  <!-- Conteúdo Central -->
                <RowDefinition Height="40"/> <!-- Rodapé -->
            </Grid.RowDefinitions>

            <!-- 1. BARRA DE TÍTULO (Arrastável) -->
            <Border Grid.Row="0" Background="#161B22" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="15,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="TitleLogo" Source="/Assets/triggerunlogo.png" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="TRIGGER RUN" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource CyanNeon}" FontFamily="Segoe UI Black"/>
                        <TextBlock Text=" | LAUNCHER MULTIPLAYER" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource WindowCtrlBtn}" Click="MinimizeBtn_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseBtn}" Margin="4,0,0,0" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. CONTEÚDO PRINCIPAL -->
            <Grid Grid.Row="1" Margin="25,20,25,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/> <!-- Painel Esquerdo: Banner e Status -->
                    <ColumnDefinition Width="*"/>   <!-- Painel Direito: Configurações e Jogar -->
                </Grid.ColumnDefinitions>

                <!-- PAINEL ESQUERDO: Banner / Branding e Status do Servidor -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Card com a Logo Oficial -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,5">
                            <Image x:Name="MainLogo" Source="/Assets/triggerunlogo.png" MaxHeight="120" MaxWidth="280" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect Color="#00F0FF" BlurRadius="18" Opacity="0.5" ShadowDepth="0"/>
                                </Image.Effect>
                            </Image>
                        </StackPanel>

                        <!-- Informações do Jogo / Descrição -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="STATUS DO SERVIDOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource OfflineRed}" Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#F85149" BlurRadius="8" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="TxtServerStatus" Text="Verificando..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhite}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtServerLatency" Text="Ping: -- ms" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="20,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="MODOS DISPONÍVEIS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="• TDM 50 Kills (15 Min)" FontSize="12" Foreground="{StaticResource TextWhite}" Margin="0,4,0,0"/>
                                    <TextBlock Text="• Partidas Personalizadas" FontSize="12" Foreground="{StaticResource TextWhite}" Margin="0,2,0,0"/>
                                    <TextBlock Text="• Modos PvE / Arena" FontSize="12" Foreground="{StaticResource TextWhite}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Botões de Ação do Painel Esquerdo -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Button Content="🔄 Atualizar" Background="Transparent" Foreground="{StaticResource CyanNeon}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Click="BtnRefreshStatus_Click"/>
                            <TextBlock Text="|" Foreground="{StaticResource CardBorder}" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="🧹 Limpar Cache" Background="Transparent" Foreground="{StaticResource OrangeAccent}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Click="BtnClearCache_Click" ToolTip="Limpa texturas e shaders antigos para reparar o jogo"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAINEL DIREITO: Formulário de Conexão e Botão Jogar -->
                <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="25" Margin="15,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Campo Nome -->
                            <RowDefinition Height="Auto"/> <!-- Campo Servidor/IP -->
                            <RowDefinition Height="Auto"/> <!-- Opções Idioma / Executável -->
                            <RowDefinition Height="*"/>    <!-- Espaçador -->
                            <RowDefinition Height="Auto"/> <!-- Botão JOGAR -->
                        </Grid.RowDefinitions>

                        <!-- 1. NOME DE USUÁRIO -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="SEU NICKNAME / NOME NO JOGO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextWhite}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtUsername" Style="{StaticResource ModernTextBox}" Text="Jogador" MaxLength="16"/>
                        </StackPanel>

                        <!-- 2. IP DO SERVIDOR -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <TextBlock Text="IP DO SERVIDOR (VPS, Radmin ou Local)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextWhite}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtServerIp" Style="{StaticResource ModernTextBox}" Text="127.0.0.1" TextChanged="TxtServerIp_TextChanged"/>
                        </StackPanel>

                        <!-- 3. CONFIGURAÇÕES ADICIONAIS (Idioma e Fechar ao Iniciar) -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="IDIOMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbLanguage" Height="36" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="10,6" FontSize="13" SelectedIndex="0">
                                    <ComboBoxItem Content="🇧🇷 Português (Baxi)" Tag="baxi"/>
                                    <ComboBoxItem Content="🇨🇳 Chinês (ZH)" Tag="zh"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,14,0,0">
                                <CheckBox x:Name="ChkCloseOnLaunch" Content="Fechar launcher ao abrir" Foreground="{StaticResource TextMuted}" IsChecked="True" FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- 4. BOTÃO JOGAR AGORA -->
                        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtLaunchError" Text="" Foreground="{StaticResource OfflineRed}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            
                            <Button x:Name="BtnLaunchGame" Height="58" Cursor="Hand" Click="BtnLaunchGame_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="#00F0FF" CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00F0FF" BlurRadius="20" Opacity="0.6" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶  JOGAR AGORA" FontSize="18" FontWeight="Black" Foreground="#0D1117" FontFamily="Segoe UI Black"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#38F8FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#00C4D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>

            <!-- 3. RODAPÉ -->
            <Border Grid.Row="2" Background="#161B22" CornerRadius="0,0,12,12">
                <Grid Margin="20,0">
                    <TextBlock Text="Trigger Run v1.1.66 • Servidor TCP 7777 / HTTP 80" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="Desenvolvido para Comunidade" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
